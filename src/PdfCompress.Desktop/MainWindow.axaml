<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PdfCompress.Desktop.ViewModels"
        mc:Ignorable="d"
        x:Class="PdfCompress.Desktop.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PDF Compress"
        Width="1080" Height="880"
        MinWidth="900" MinHeight="700"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <!-- Заголовок раздела -->
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Пояснение мелким шрифтом -->
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Тонкая линия-разделитель между разделами -->
    <Style Selector="Border.rule">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Стрелка на разделителе: показывает, куда движется работа -->
    <Style Selector="TextBlock.flowArrow">
      <Setter Property="Opacity" Value="0.35" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="12,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Блок способа сжатия: неактивный приглушён и обведён серым -->
    <Style Selector="Border.mode">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Border.mode.active">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="MinWidth" Value="150" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Строка-заголовок группы в результатах -->
    <Style Selector="TextBlock.groupTitle">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Кнопка «О программе» зеленеет и мигает, когда найдено обновление -->
    <Style Selector="Button.updateAvailable /template/ ContentPresenter">
      <Setter Property="Background" Value="#3A8A3F" />
    </Style>
    <Style Selector="Button.updateAvailable:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2E6F33" />
    </Style>
    <Style Selector="Button.updateAvailable">
      <Setter Property="Foreground" Value="White" />
      <Style.Animations>
        <Animation Duration="0:0:0.8" IterationCount="5">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.4" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Grid Margin="16" RowDefinitions="Auto,*" RowSpacing="8">

    <!-- ── Шапка: имя программы и «О программе» ─────────────────────────────────────── -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="PDF Compress" FontSize="17" FontWeight="Bold" />
        <TextBlock Text="пакетное сжатие PDF" Classes="hint" VerticalAlignment="Bottom" Margin="0,0,0,3" />
      </StackPanel>

      <!-- Подпись словами, а не значком: знака «ℹ» нет в Inter, подхватывается шрифт эмодзи,
           и вместо буквы получается синяя плашка. -->
      <Button Grid.Column="1" Content="О программе" Padding="12,5"
              Classes.updateAvailable="{Binding IsUpdateAvailable}"
              ToolTip.Tip="Сведения о программе и проверка обновлений">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight">
            <StackPanel Width="320" Spacing="2">
              <TextBlock Text="PDF Compress" FontWeight="Bold" FontSize="16" />
              <TextBlock Text="пакетное сжатие PDF без внешних утилит" Classes="hint" />
              <TextBlock Text="{Binding AppVersionText}" Classes="hint" Margin="0,4,0,0" />
              <TextBlock Text="Автор: Inbasko" Margin="0,6,0,0" />
              <TextBlock Text="github.com/OlBaskov-rec/pdfCompress" Classes="hint" />

              <Border Classes="rule" Margin="0,10" />

              <Button Content="Проверить обновление"
                      IsVisible="{Binding ShowCheckButton}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Command="{Binding CheckUpdatesManualCommand}" />
              <Button Content="{Binding UpdateFoundButtonText}"
                      IsVisible="{Binding ShowRevealButton}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Background="#3A8A3F" Foreground="White" FontWeight="Bold"
                      Command="{Binding RevealUpdateCommand}" />

              <TextBlock Text="{Binding UpdateCheckStatus}" Classes="hint" Margin="0,8,0,0"
                         IsVisible="{Binding UpdateCheckStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <!-- ── Панель папок слева + основная часть справа ──────────────────────────────── -->
    <Grid Grid.Row="1" ColumnDefinitions="260,8,*">

      <!-- ── 1. Папки-источники ─────────────────────────────────────────────────────── -->
      <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6">
        <TextBlock Grid.Row="0" Classes="section" Text="1. Папки с PDF-файлами" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <Button Grid.Column="0" Content="+ Добавить папку"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{Binding AddFolderCommand}" />
          <Button Grid.Column="1" Content="−"
                  ToolTip.Tip="Убрать выбранную папку из списка"
                  Command="{Binding RemoveFolderCommand}" />
        </Grid>

        <Border Grid.Row="2"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                CornerRadius="6">
          <ListBox ItemsSource="{Binding Folders}" Background="Transparent"
                   SelectionMode="Single"
                   SelectedItem="{Binding SelectedFolder}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SourceFolderItem">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Обрабатывать файлы этой папки" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Path}" />
                    <TextBlock Text="{Binding Summary}" Classes="hint" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Spacing="6">
          <CheckBox Content="Искать и во вложенных папках" IsChecked="{Binding IncludeSubfolders}" />
          <Button Content="⟳ Перечитать папки"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{Binding RefreshCommand}" />
        </StackPanel>
      </Grid>

      <GridSplitter Grid.Column="1" Background="Transparent" />

      <!-- ── Основная часть ─────────────────────────────────────────────────────────── -->
      <Grid Grid.Column="2" RowSpacing="6"
            RowDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">

        <!-- Найденные файлы -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Text="{Binding FilesSummary}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Отметить все" Command="{Binding SelectAllCommand}" />
          <Button Grid.Column="2" Content="Снять отметки" Command="{Binding ClearSelectionCommand}" />
        </Grid>

        <Border Grid.Row="1"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                CornerRadius="6">
          <ListBox ItemsSource="{Binding Files}" Background="Transparent" SelectionMode="Single">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PdfFileItem">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" />
                  <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding FullPath}" />
                  <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                             VerticalAlignment="Center" Opacity="0.7" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <!-- Переход к разделу 2 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*" Margin="0,6,0,4">
          <Border Grid.Column="0" Classes="rule" />
          <TextBlock Grid.Column="1" Classes="flowArrow" Text="▼" />
          <Border Grid.Column="2" Classes="rule" />
        </Grid>

        <!-- ── 2. Способ сжатия: активен ровно один из двух блоков ──────────────────── -->
        <StackPanel Grid.Row="3" Spacing="8">
          <TextBlock Classes="section" Text="2. Как сжимать (доступен один из двух способов)" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

            <!-- Степень сжатия -->
            <Border Grid.Column="0" Classes="mode" Classes.active="{Binding UseLevelMode}"
                    IsEnabled="{Binding UseLevelMode}">
              <StackPanel Spacing="8">
                <Slider Minimum="1" Maximum="5"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        TickPlacement="BottomRight"
                        Value="{Binding LevelValue}" />
                <TextBlock Text="{Binding LevelName}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Classes="hint" Text="{Binding LevelDetails}" />
              </StackPanel>
            </Border>

            <!-- Предельный размер -->
            <Border Grid.Column="1" Classes="mode" Classes.active="{Binding UseTargetSizeMode}"
                    IsEnabled="{Binding UseTargetSizeMode}">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding MaxSizeValue}"
                                 Minimum="0" Maximum="1000000"
                                 Increment="1" FormatString="0.###"
                                 PlaceholderText="Размер" />
                  <ComboBox Grid.Column="1" MinWidth="90"
                            ItemsSource="{Binding Units}"
                            SelectedItem="{Binding SelectedUnit}" />
                </Grid>

                <!-- Область действия предела: оба флажка одновременно включить нельзя,
                     снятые оба означают «предел на каждый файл». -->
                <CheckBox Content="предел на всю папку целиком"
                          IsChecked="{Binding LimitPerFolder}"
                          ToolTip.Tip="Отслеживать максимальный размер папки: в предел должна уложиться сумма всех её файлов, включая вложенные папки" />
                <CheckBox Content="предел на каждую подпапку"
                          IsChecked="{Binding LimitPerSubfolder}"
                          ToolTip.Tip="Следить за максимальным размером каждой подпапки по отдельности: каждая подпапка первого уровня укладывается в предел сама по себе" />

                <TextBlock Classes="hint" Text="{Binding TargetSizeHint}" />
                <TextBlock Classes="hint" Text="{Binding ScopeHint}" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- Переключатель способа: подписи стоят под блоками, чтобы связь была очевидна -->
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <RadioButton Grid.Column="0" GroupName="mode"
                         Content="Степень сжатия"
                         IsChecked="{Binding UseLevelMode}" />
            <RadioButton Grid.Column="1" GroupName="mode"
                         Content="Максимальный размер"
                         IsChecked="{Binding UseTargetSizeMode}" />
          </Grid>
        </StackPanel>

        <!-- Переход к разделу 3 -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,*" Margin="0,6,0,4">
          <Border Grid.Column="0" Classes="rule" />
          <TextBlock Grid.Column="1" Classes="flowArrow" Text="▼" />
          <Border Grid.Column="2" Classes="rule" />
        </Grid>

        <!-- ── 3. Куда сохранять и запуск ───────────────────────────────────────────── -->
        <StackPanel Grid.Row="5" Spacing="6">
          <TextBlock Classes="section" Text="3. Папка для результатов" />
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding OutputFolderDisplay}"
                     IsReadOnly="True" />
            <Button Grid.Column="1" Content="Обзор…" Command="{Binding BrowseOutputCommand}" />
            <Button Grid.Column="2" Content="↺"
                    ToolTip.Tip="Вернуть раскладку по умолчанию — рядом с каждой папкой-источником"
                    Command="{Binding UseDefaultOutputCommand}" />
            <Button Grid.Column="3" Classes="primary" Content="▶ Обработать"
                    IsVisible="{Binding IsIdle}"
                    Command="{Binding ProcessCommand}" />
            <Button Grid.Column="3" Classes="primary" Content="■ Отмена"
                    IsVisible="{Binding IsBusy}"
                    Command="{Binding CancelCommand}" />
            <Button Grid.Column="4" Content="📂"
                    ToolTip.Tip="Открыть папку результатов"
                    Command="{Binding OpenOutputFolderCommand}" />
          </Grid>
        </StackPanel>

        <!-- Ход выполнения -->
        <StackPanel Grid.Row="6" Spacing="4">
          <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="6"
                       IsVisible="{Binding IsBusy}" />
          <TextBlock Text="{Binding StatusText}" Classes="hint" />
          <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                     Foreground="{DynamicResource SystemErrorTextColor}"
                     IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <!-- Баннер готового обновления -->
        <Border Grid.Row="7" Background="#E7F3E8" BorderBrush="#3A8A3F" BorderThickness="1"
                CornerRadius="6" Padding="10,8" Margin="0,4,0,0"
                IsVisible="{Binding IsUpdateReady}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
              <Button Content="Отложить" Command="{Binding PostponeUpdateCommand}"
                      ToolTip.Tip="Убрать баннер; обновиться можно позже через «О программе»" />
              <Button Content="⟳ Обновить и перезапустить"
                      Command="{Binding ApplyUpdateCommand}"
                      Background="#3A8A3F" Foreground="White" FontWeight="Bold" />
            </StackPanel>
            <TextBlock Text="{Binding UpdateText}" VerticalAlignment="Center"
                       Foreground="#1E5E22" FontWeight="SemiBold" TextWrapping="Wrap" />
          </DockPanel>
        </Border>

        <!-- Переход к результатам -->
        <Grid Grid.Row="8" ColumnDefinitions="*,Auto,*" Margin="0,6,0,4">
          <Border Grid.Column="0" Classes="rule" />
          <TextBlock Grid.Column="1" Classes="flowArrow" Text="▼" />
          <Border Grid.Column="2" Classes="rule" />
        </Grid>

        <!-- Результаты -->
        <Border Grid.Row="9"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                CornerRadius="6">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Results}" Margin="10">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ResultRow">
                  <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontWeight="Bold" Width="16" />
                    <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                               MaxWidth="320"
                               Classes.groupTitle="{Binding IsGroupHeader}" />
                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Opacity="0.85"
                               TextWrapping="Wrap"
                               Classes.groupTitle="{Binding IsGroupHeader}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="10" Text="{Binding ResultsSummary}" FontWeight="SemiBold" Margin="0,4,0,0"
                   IsVisible="{Binding ResultsSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </Grid>
    </Grid>
  </Grid>
</Window>
