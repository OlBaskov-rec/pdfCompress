<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PdfCompress.Desktop.ViewModels"
        mc:Ignorable="d"
        x:Class="PdfCompress.Desktop.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PDF Compress"
        Width="900" Height="800"
        MinWidth="720" MinHeight="620"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <!-- Заголовок раздела -->
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Пояснение мелким шрифтом -->
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Блок способа сжатия: неактивный приглушён и обведён серым -->
    <Style Selector="Border.mode">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Border.mode.active">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="MinWidth" Value="150" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>

  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,*,Auto" RowSpacing="10">

    <!-- ── 1. Папка с исходными файлами ─────────────────────────────────────────────── -->
    <StackPanel Grid.Row="0" Spacing="6">
      <TextBlock Classes="section" Text="1. Папка с PDF-файлами" />
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0"
                 Text="{Binding SourceFolder}"
                 PlaceholderText="Путь к папке — выберите кнопкой «Обзор…»"
                 IsReadOnly="True" />
        <Button Grid.Column="1" Content="Обзор…" Command="{Binding BrowseSourceCommand}" />
        <Button Grid.Column="2" Content="⟳"
                ToolTip.Tip="Перечитать папку"
                Command="{Binding RefreshCommand}" />
      </Grid>
      <CheckBox Content="Искать и во вложенных папках" IsChecked="{Binding IncludeSubfolders}" />
    </StackPanel>

    <!-- ── 2. Список найденных файлов ───────────────────────────────────────────────── -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <TextBlock Grid.Column="0" Text="{Binding FilesSummary}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Отметить все" Command="{Binding SelectAllCommand}" />
      <Button Grid.Column="2" Content="Снять отметки" Command="{Binding ClearSelectionCommand}" />
    </Grid>

    <Border Grid.Row="2"
            BorderThickness="1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            CornerRadius="6"
            MinHeight="120">
      <ListBox ItemsSource="{Binding Files}" Background="Transparent" SelectionMode="Single">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PdfFileItem">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" />
              <TextBlock Grid.Column="1" Text="{Binding FileName}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding FullPath}" />
              <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                         VerticalAlignment="Center" Opacity="0.7" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- ── 3. Способ сжатия: активен ровно один из двух блоков ──────────────────────── -->
    <StackPanel Grid.Row="3" Spacing="8">
      <TextBlock Classes="section" Text="2. Как сжимать (доступен один из двух способов)" />
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

        <!-- Степень сжатия -->
        <Border Grid.Column="0" Classes="mode" Classes.active="{Binding UseLevelMode}"
                IsEnabled="{Binding UseLevelMode}">
          <StackPanel Spacing="8">
            <Slider Minimum="1" Maximum="5"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    TickPlacement="BottomRight"
                    Value="{Binding LevelValue}" />
            <TextBlock Text="{Binding LevelName}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Classes="hint" Text="{Binding LevelDetails}" />
          </StackPanel>
        </Border>

        <!-- Предельный размер файла -->
        <Border Grid.Column="1" Classes="mode" Classes.active="{Binding UseTargetSizeMode}"
                IsEnabled="{Binding UseTargetSizeMode}">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <NumericUpDown Grid.Column="0"
                             Value="{Binding MaxSizeValue}"
                             Minimum="0" Maximum="1000000"
                             Increment="1" FormatString="0.###"
                             PlaceholderText="Размер" />
              <ComboBox Grid.Column="1" MinWidth="90"
                        ItemsSource="{Binding Units}"
                        SelectedItem="{Binding SelectedUnit}" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding TargetSizeHint}" />
            <TextBlock Classes="hint"
                       Text="Степень подбирается сама — самая щадящая из тех, что укладываются в предел." />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Переключатель способа: подписи стоят под блоками, чтобы связь была очевидна -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <RadioButton Grid.Column="0" GroupName="mode"
                     Content="Степень сжатия"
                     IsChecked="{Binding UseLevelMode}" />
        <RadioButton Grid.Column="1" GroupName="mode"
                     Content="Максимальный размер файла"
                     IsChecked="{Binding UseTargetSizeMode}" />
      </Grid>
    </StackPanel>

    <!-- ── 4. Куда сохранять и запуск ───────────────────────────────────────────────── -->
    <StackPanel Grid.Row="4" Spacing="6">
      <TextBlock Classes="section" Text="3. Папка для результатов" />
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0" Text="{Binding OutputFolder}"
                 PlaceholderText="Подпапка «compressed» рядом с исходными файлами"
                 IsReadOnly="True" />
        <Button Grid.Column="1" Content="Обзор…" Command="{Binding BrowseOutputCommand}" />
        <Button Grid.Column="2" Classes="primary" Content="▶ Обработать"
                IsVisible="{Binding IsIdle}"
                Command="{Binding ProcessCommand}" />
        <Button Grid.Column="2" Classes="primary" Content="■ Отмена"
                IsVisible="{Binding IsBusy}"
                Command="{Binding CancelCommand}" />
        <Button Grid.Column="3" Content="📂"
                ToolTip.Tip="Открыть папку результатов"
                Command="{Binding OpenOutputFolderCommand}" />
      </Grid>
    </StackPanel>

    <!-- ── 5. Ход выполнения ────────────────────────────────────────────────────────── -->
    <StackPanel Grid.Row="5" Spacing="6">
      <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="6"
                   IsVisible="{Binding IsBusy}" />
      <TextBlock Text="{Binding StatusText}" Classes="hint" />
      <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                 Foreground="{DynamicResource SystemErrorTextColor}"
                 IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <!-- ── 6. Результаты ────────────────────────────────────────────────────────────── -->
    <Border Grid.Row="6"
            BorderThickness="1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            CornerRadius="6"
            MinHeight="110">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Results}" Margin="10">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ResultRow">
              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" Margin="0,2">
                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontWeight="Bold" Width="16" />
                <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                           MaxWidth="320" />
                <TextBlock Grid.Column="2" Text="{Binding Detail}" Opacity="0.85"
                           TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="7" Text="{Binding ResultsSummary}" FontWeight="SemiBold"
               IsVisible="{Binding ResultsSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </Grid>
</Window>
