<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PdfCompress.Desktop.App"
             RequestedThemeVariant="Default">
    <!-- Default — тема следует системной; допустимы также Dark и Light. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
