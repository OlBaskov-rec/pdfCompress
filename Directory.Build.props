<Project>

  <!--
    Аудит NuGet ругается на System.Security.Cryptography.Pkcs 8.0.1, который приходит
    транзитивно из PdfSharp. Гасим ровно эти два предупреждения и только их — подавление
    идёт по адресу конкретной уязвимости, а не по имени пакета, поэтому новая уязвимость
    в том же пакете по-прежнему будет видна.

    Обоснование: сборки, которым этот пакет нужен, в поставку не попадают вовсе —
    см. Directory.Build.targets. Пакет нужен единственному классу PdfSharpDefaultSigner,
    который ставит цифровую подпись на PDF; мы документы только читаем и пересобираем.
    Исправленной версии пакета не существует: предупреждение висит на всех опубликованных,
    включая 9.0 и 10.0, потому что заплатка живёт в рантайме .NET, а отдельный пакет
    остаётся как есть. Проверено также обновление PdfSharp до 6.5.0 — зависимость та же.

    Если PdfSharp когда-нибудь перестанет тянуть этот пакет, обе строки надо удалить
    вместе с целями в Directory.Build.targets.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2fmv-rv2c-59x7" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-846f-f764-76mx" />
  </ItemGroup>

</Project>
